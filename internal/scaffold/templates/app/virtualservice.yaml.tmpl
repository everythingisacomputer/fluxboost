---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: {{ .Name }}
spec:
  hosts:
    - "{{ .Host }}"
  gateways:
    - "${env}/${env}"
  http:
    - match:
        - uri:
            prefix: /
      route:
        - destination:
            host: {{ .Name }}
            port:
              number: 80
