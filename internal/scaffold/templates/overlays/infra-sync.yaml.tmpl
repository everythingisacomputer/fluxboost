# One Flux Kustomization per platform service. Generated by fluxboost.
# Substitution values are passed down from clusters/{{ .C.Env }}/infra/sync.yaml.
{{- range .Entries }}
---
apiVersion: {{ $.C.APIs.Kustomize }}
kind: Kustomization
metadata:
  name: {{ .Name }}
  namespace: flux-system
spec:
  interval: 10m0s
  path: {{ .Path }}
  prune: true
{{- if $.C.Sops }}
  decryption:
    provider: sops
    secretRef:
      name: sops-age
{{- end }}
{{- if .TargetNamespace }}
  targetNamespace: {{ .TargetNamespace }}
{{- end }}
  dependsOn:
    - name: infra
{{- range .DependsOn }}
    - name: {{ . }}
{{- end }}
  sourceRef:
    kind: GitRepository
    name: flux-system
  postBuild:
    substitute:
{{- range $.C.Vars }}
      {{ .Name }}: {{ ref .Name }}
{{- end }}
{{- end }}
