---
apiVersion: {{ .C.APIs.HelmRepository }}
kind: HelmRepository
metadata:
  name: vault
spec:
  interval: 10m0s
  url: https://helm.releases.hashicorp.com
---
apiVersion: {{ .C.APIs.HelmRelease }}
kind: HelmRelease
metadata:
  name: vault
spec:
  chart:
    spec:
      chart: vault
      version: "0.29.0"
      reconcileStrategy: ChartVersion
      sourceRef:
        kind: HelmRepository
        name: vault
  interval: 10m0s
  values:
    injector:
      enabled: true
    server:
      ha:
        enabled: false
        replicas: 1
        config: |
          disable_mlock = true
          ui = true

          storage "file" {
            path = "/mnt/vault/data"
          }

          listener "tcp" {
            tls_disable = 1
            address = "[::]:8200"
            cluster_address = "[::]:8201"
          }

          service_registration "kubernetes" {}
    ui:
      enabled: true
      serviceType: "ClusterIP"
      externalPort: 8200
