# Shared Istio Gateway for the environment. Workloads attach with
# `gateways: ["${env}/${env}"]` in their VirtualService.
apiVersion: networking.istio.io/v1
kind: Gateway
metadata:
  name: ${env}
spec:
  # Matches the pod labels of the istio-gateway HelmRelease.
  selector:
    istio: gateway
  servers:
    - port:
        number: 443
        name: https
        protocol: HTTPS
      hosts:
        - "${env}.${baseDomain}"
        - "*.${env}.${baseDomain}"
      tls:
        mode: SIMPLE
        credentialName: ${env}.${baseDomain}
