---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    email: ${domainManagerEmail}
    server: https://acme-v02.api.letsencrypt.org/directory
    privateKeySecretRef:
      name: letsencrypt-prod
    solvers:
{{- if eq .C.Provider "gcp" }}
      - dns01:
          cloudDNS:
            project: ${gcloudProjectId}
{{- else if eq .C.Provider "aws" }}
      - dns01:
          route53:
            region: ${awsRegion}
{{- else }}
      # HTTP01 needs an ingress reachable on port 80. Adjust the class to
      # whatever serves ingress traffic in your cluster.
      - http01:
          ingress:
{{- if has "istiod" }}
            ingressClassName: istio
{{- else }}
            ingressClassName: nginx
{{- end }}
{{- end }}
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-staging
spec:
  acme:
    email: ${domainManagerEmail}
    server: https://acme-staging-v02.api.letsencrypt.org/directory
    privateKeySecretRef:
      name: letsencrypt-staging
    solvers:
{{- if eq .C.Provider "gcp" }}
      - dns01:
          cloudDNS:
            project: ${gcloudProjectId}
{{- else if eq .C.Provider "aws" }}
      - dns01:
          route53:
            region: ${awsRegion}
{{- else }}
      - http01:
          ingress:
{{- if has "istiod" }}
            ingressClassName: istio
{{- else }}
            ingressClassName: nginx
{{- end }}
{{- end }}
