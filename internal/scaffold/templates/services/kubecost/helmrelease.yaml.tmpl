---
apiVersion: {{ .C.APIs.HelmRepository }}
kind: HelmRepository
metadata:
  name: kubecost
spec:
  interval: 10m0s
  url: https://kubecost.github.io/cost-analyzer
---
apiVersion: {{ .C.APIs.HelmRelease }}
kind: HelmRelease
metadata:
  name: kubecost
spec:
  chart:
    spec:
      chart: cost-analyzer
      version: "2.4.3"
      reconcileStrategy: ChartVersion
      sourceRef:
        kind: HelmRepository
        name: kubecost
  interval: 10m0s
