---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: kubecost
spec:
  hosts:
    - "kubecost.${env}.${baseDomain}"
  gateways:
    - "${env}/${env}"
  http:
    - match:
        - uri:
            prefix: /
      route:
        - destination:
            host: kubecost-cost-analyzer
            port:
              number: 9090
