# ClusterSecretStore backed by the in-cluster Vault. Requires a
# `vault-token-global` Secret in the external-secrets namespace holding a
# Vault token under the `token` key.
apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: vault
spec:
  provider:
    vault:
      server: "http://vault.vault.svc.cluster.local:8200"
      path: secret
      version: v2
      auth:
        tokenSecretRef:
          name: "vault-token-global"
          key: "token"
          namespace: external-secrets
